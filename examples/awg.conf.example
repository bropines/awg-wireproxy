# Example AmneziaWG client with a SOCKS5 and an HTTP proxy.
# Copy to /etc/wireproxy/config (Docker) or pass it with -c.
[Interface]
Address = 10.200.200.2/32
PrivateKey = uCTIK+56CPyCvwJxmU5dBfuyJvPuSXAq1FzHdnIxe1Q=
DNS = 10.200.200.1

# AmneziaWG: the S*/H* values must match the server. Remove what you do not use.
Jc = 5
Jmin = 10
Jmax = 50
S1 = 20
S2 = 30
H1 = 100000-200000
H2 = 300000-400000
H3 = 500000-600000
H4 = 700000-800000

[Peer]
PublicKey = QP+A67Z2UBrMgvNIdHv8gPel5URWNLS4B3ZQ2hQIZlg=
Endpoint = 203.0.113.10:51820   # server IP or hostname
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25

# Inside a container bind to 0.0.0.0 and publish the port with -p / ports:.
[Socks5]
BindAddress = 0.0.0.0:25344

[http]
BindAddress = 0.0.0.0:25345
